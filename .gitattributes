# Normalize every text file to LF in the repository, whatever the local
# core.autocrlf says. Without it, a Windows machine with autocrlf=true checked
# the checklists out with CRLF, make-keycheck rewrote them with LF, and the
# run left a modified TESTING-KEYS.md that stopped every later firing.
* text=auto eol=lf

# Cargo.lock is generated; keep it out of diffs and merge conflicts.
Cargo.lock linguist-generated=true
